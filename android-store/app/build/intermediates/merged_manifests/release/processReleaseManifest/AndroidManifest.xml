<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mtk.store"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <queries>
        <package android:name="com.mtk.media" />
        <package android:name="com.mtk.prime" />
        <package android:name="com.mtk.kids" />
        <package android:name="com.mtk.arabic" />
        <package android:name="com.mtk.classic" />
        <package android:name="com.mtk.wwe" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="MTK STORE"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/MtkTheme"
        android:usesCleartextTraffic="false" >
        <activity
            android:name="com.mtk.store.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>